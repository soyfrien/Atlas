# Rendered by install.sh (ATLAS_HOST is replaced). Caddy obtains and renews the Let's Encrypt certificate automatically.
__ATLAS_HOST__ {
	reverse_proxy 127.0.0.1:5100 {
		flush_interval -1
		transport http {
			response_header_timeout 30m
		}
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}
