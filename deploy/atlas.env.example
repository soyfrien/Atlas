# Copy to /etc/atlas/atlas.env on the server (chmod 640, root:atlas-app). NEVER commit the real file.
ATLAS_PASSCODE=change-me-to-a-long-random-string

# Optional overrides (double underscore = nested setting):
#Atlas__MaxUploadBytes=6442450944
#Atlas__MinFreeBytes=2147483648
#Atlas__OcrMaxPages=60
#Atlas__OcrLanguage=eng
# Transcription hook: the command must print the transcript to stdout; {input} is replaced by the media file path.
#Atlas__TranscriptionCommand=/opt/whisper.cpp/whisper-cli
#Atlas__TranscriptionArgs__0=-m
#Atlas__TranscriptionArgs__1=/opt/whisper.cpp/models/ggml-tiny.en.bin
#Atlas__TranscriptionArgs__2=-nt
#Atlas__TranscriptionArgs__3=-f
#Atlas__TranscriptionArgs__4={input}
